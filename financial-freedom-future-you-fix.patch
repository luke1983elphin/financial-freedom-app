+++ b/tests/future-you-summary.test.mjs
@@ -0,0 +1,219 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import vm from "node:vm";
+
+const read = (file) => readFileSync(new URL("../" + file, import.meta.url), "utf8");
+const context = { console };
+context.globalThis = context;
+vm.runInNewContext(read("calculator.js"), context);
+const CALC = context.FFSCalculator;
+const appSource = read("app.js");
+function appFunction(name) {
+  const start = appSource.indexOf("  function " + name + "(");
+  assert.ok(start >= 0);
+  const end = appSource.indexOf("\n  function ", start + 1);
+  return appSource.slice(start, end < 0 ? undefined : end);
+}
+function preview(result, age, currentAge = 43) {
+  const sandbox = {
+    plan: { personal: { person1Age: currentAge, fullRetirementAge: 60 }, assets: { offsetBalance: 0 } },
+    engagementData: () => ({ futureYouAge: age }),
+    engagementProgress: () => ({ financialFreedomRaw: result.financialFreedomProgressRaw }),
+    safeWithdrawalRate: () => 0.04,
+  };
+  vm.runInNewContext(["projectionRowAtAge", "projectionYearForAge", "mortgageBalanceAtAge", "futureYouPreview"].map(appFunction).join("\n"), sandbox);
+  return sandbox.futureYouPreview(result);
+}
+function planWithHomeLoan(termYears = 25) {
+  const plan = CALC.emptyPlan();
+  Object.assign(plan.personal, { person1Age: 43, targetAnnualSpending: 60000 });
+  Object.assign(plan.assets, { homeValue: 1000000, cash: 150000, offsetBalance: 200000, superPerson1: 200000 });
+  Object.assign(plan.liabilities, { homeLoanBalance: 600000, homeLoanInterestRatePct: 6, monthlyRepayment: 4000, remainingLoanTermYears: termYears });
+  return plan;
+}
+test("Future You current position uses canonical FI assets including offset exactly once", () => {
+  const result = CALC.calculatePlan(planWithHomeLoan());
+  const future = preview(result, 43);
+  assert.equal(future.projectedFiAssets, result.financialIndependenceAssets);
+  assert.equal(future.projectedFiAssets, 350000);
+  assert.equal(future.netWorth, result.currentNetWorth);
+  assert.equal(future.passiveIncome, 14000);
+});
+test("Future You current-age super inclusion follows the calculator result", () => {
+  const plan = planWithHomeLoan();
+  plan.personal.person1Age = 60;
+  const result = CALC.calculatePlan(plan);
+  assert.equal(preview(result, 60, 60).projectedFiAssets, 550000);
+});
+test("Future You preserves genuine zero projected values rather than reverting to today", () => {
+  const result = CALC.calculatePlan(planWithHomeLoan());
+  result.investmentProjection = [{ age: 44, year: 1, closingBalance: 0 }];
+  result.superProjection = [{ age: 44, closingBalance: 0 }];
+  result.netWorthProjection = [{ age: 44, closingBalance: 0 }];
+  result.financialFreedomProgressProjection = [{ age: 44, netFiAssets: 0, progress: 0 }];
+  const future = preview(result, 44);
+  for (const key of ["investmentBalance", "superBalance", "netWorth", "projectedFiAssets", "passiveIncome", "progress"]) assert.equal(future[key], 0, key);
+});
+test("Future You subsequent-year figures come from matching calculator projection rows", () => {
+  const result = CALC.calculatePlan(planWithHomeLoan());
+  const future = preview(result, 44);
+  assert.equal(future.netWorth, result.netWorthProjection[0].closingBalance);
+  assert.equal(future.projectedFiAssets, result.financialFreedomProgressProjection[0].netFiAssets);
+  assert.equal(future.progress, result.financialFreedomProgressProjection[0].progress);
+});
+test("Entered home-loan repayments remain visible when remaining term is missing", () => {
+  const result = CALC.calculatePlan(planWithHomeLoan(0));
+  assert.equal(result.annualMortgageRepayments, 48000);
+  assert.equal(result.annualDebtRepayments, 48000);
+});
+test("Paid-off home loans still have zero annual repayments", () => {
+  const plan = planWithHomeLoan(0);
+  plan.liabilities.homeLoanBalance = 0;
+  assert.equal(CALC.calculatePlan(plan).annualDebtRepayments, 0);
+});
+test("Rental debt does not disappear from projected net worth", () => {
+  const plan = CALC.emptyPlan();
+  plan.personal.person1Age = 43;
+  plan.assets.otherPropertyValue = 900000;
+  plan.assetItems = [{ id: "rental", category: "rentalInvestmentProperty", value: 900000 }];
+  plan.liabilityItems = [{ id: "rental-loan", type: "rentalPropertyLoan", balance: 600000, linkedAssetId: "rental", repayment: 0 }];
+  const withDebt = CALC.calculatePlan(plan);
+  const withoutDebt = CALC.calculatePlan({ ...plan, liabilityItems: [] });
+  assert.equal(withoutDebt.currentNetWorth - withDebt.currentNetWorth, 600000);
+  for (let i = 0; i < withDebt.netWorthProjection.length; i++) {
+    assert.equal(Math.round((withoutDebt.netWorthProjection[i].closingBalance - withDebt.netWorthProjection[i].closingBalance) * 100) / 100, 600000);
+  }
+});
+test("Live Summary identifies the super amount as current and offers an explanation", () => {
+  const container = { innerHTML: "", classList: { toggle() {} } };
+  const sandbox = {
+    document: { getElementById: () => container },
+    personalisedResultsReadiness: () => ({ readyForPersonalisedResults: true }),
+    plan: { investing: {} }, freedomPercent: () => 0, plainPercent: String,
+    financialStageInfo: () => ({ stage: { name: "Starting" } }), money: String,
+    netWorthAtYear: () => 0, escapeHtml: String,
+    infoButtonHtml: (key) => '<button data-info="' + key + '">Info</button>',
+  };
+  vm.runInNewContext(appFunction("renderSetupSummary"), sandbox);
+  sandbox.renderSetupSummary({ superannuationBalance: 200000, annualDebtRepayments: 0, annualLoanRepayments: 48000 });
+  assert.match(container.innerHTML, /Super balance today/);
+  assert.match(container.innerHTML, /data-info="currentSuperBalance"/);
+  assert.match(container.innerHTML, /Annual Loan Repayments[\s\S]*?48000/);
+  assert.match(appSource, /currentSuperBalance:[\s\S]*?current combined super balance[\s\S]*?conditions of release/);
+});
+
+test("Canonical offset records override stale legacy offsets without double counting", () => {
+  const plan = planWithHomeLoan();
+  plan.assets.offsetBalance = 0;
+  plan.assetItems = [{ id: "offset", category: "offset", value: 200000 }, { id: "cash", category: "cash", value: 150000 }];
+  const result = CALC.calculatePlan(plan);
+  assert.equal(preview(result, 43).projectedFiAssets, 350000);
+  plan.assets.offsetBalance = 200000;
+  assert.equal(preview(CALC.calculatePlan(plan), 43).projectedFiAssets, 350000);
+});
+test("Current FI keeps investment debt, property equity and accessible super policy", () => {
+  const plan = planWithHomeLoan();
+  plan.assets.otherPropertyValue = 900000;
+  plan.liabilityItems = [{ id: "rental-loan", type: "rentalPropertyLoan", balance: 600000 }, { id: "investment-loan", type: "investmentLoan", balance: 50000 }];
+  const result = CALC.calculatePlan(plan);
+  assert.equal(result.financialIndependenceAssets, 600000);
+  assert.equal(preview(result, 43).projectedFiAssets, 600000);
+});
+test("Missing-term projection caps payments at the amount actually owed", () => {
+  const plan = planWithHomeLoan(0);
+  plan.liabilities.homeLoanBalance = 1000;
+  plan.liabilities.homeLoanInterestRatePct = 0;
+  const result = CALC.calculatePlan(plan);
+  assert.equal(result.annualDebtRepayments, 1000);
+  assert.equal(result.loan.finalBalance, 0);
+  assert.equal(result.loan.warnings.some(w => w.code === "LOAN_TERM_MISSING"), true);
+});
+test("Missing-term mortgage retains debt, capitalises unpaid interest and uses offset only for interest", () => {
+  const plan = planWithHomeLoan(0);
+  plan.liabilities.monthlyRepayment = 1000;
+  const result = CALC.calculatePlan(plan);
+  const row = result.loan.schedule[11];
+  assert.ok(row.closingBalance > 600000);
+  assert.equal(result.loan.schedule[0].interestCharged, 2000);
+  assert.equal(preview(result, 43).mortgageBalance, 600000);
+  assert.equal(preview(result, 44).mortgageBalance, row.closingBalance);
+});
+
+function rentalPlan(repaymentType = "interestOnly", treatment = "afterInterest") {
+  const plan = CALC.emptyPlan();
+  plan.liabilityItems = [{ id: "rental-loan", type: "rentalPropertyLoan", balance: 600000, interestRatePct: 6, repayment: 3000, repaymentFrequency: "monthly", termYears: 25, repaymentType, linkedRentalIncomeId: "rent" }];
+  plan.incomeItems = [{ id: "rent", type: "rentalNetCashIncome", owner: "person1", rentalCashIncomeAnnual: 12000, rentalCashflowTreatment: treatment, linkedLoanIds: ["rental-loan"] }];
+  return plan;
+}
+test("Positive-term rental interest-only payments are reported without deducting interest twice", () => {
+  const plan = rentalPlan();
+  const result = CALC.calculatePlan(plan);
+  assert.equal(result.annualLoanRepayments, 36000);
+  assert.equal(result.annualDebtRepayments, 0);
+  assert.equal(result.rentalPropertyCashflow.annualHouseholdDebtDeduction, 0);
+  const before = structuredClone(plan);
+  before.incomeItems[0].rentalCashflowTreatment = "beforeInterest";
+  before.incomeItems[0].rentalCashIncomeAnnual = 48000;
+  const other = CALC.calculatePlan(before);
+  assert.equal(other.annualLoanRepayments, 36000);
+  assert.equal(other.annualDebtRepayments, 36000);
+  assert.equal(other.rentalPropertyCashflow.annualHouseholdCashflowContribution, result.rentalPropertyCashflow.annualHouseholdCashflowContribution);
+});
+test("Rental principal-and-interest summary reports full payments, preserving principal-only deduction", () => {
+  const plan = rentalPlan("principalAndInterest");
+  plan.liabilityItems[0].repayment = 4000;
+  const result = CALC.calculatePlan(plan);
+  assert.equal(result.annualLoanRepayments, 48000);
+  assert.equal(result.annualDebtRepayments, result.rentalPropertyCashflow.annualLoanPrincipal);
+  assert.ok(result.annualDebtRepayments > 0 && result.annualDebtRepayments < 48000);
+});
+test("Rental payment total handles frequencies, missing term, unlinked records and paid-off balances", () => {
+  for (const [frequency, repayment] of [["weekly",1000],["fortnightly",2000],["monthly",52000/12],["annually",52000]]) {
+    const plan = rentalPlan("principalAndInterest");
+    Object.assign(plan.liabilityItems[0], { repaymentFrequency: frequency, repayment, termYears: 0, linkedRentalIncomeId: "" });
+    plan.incomeItems = [];
+    const result = CALC.calculatePlan(plan);
+    assert.ok(Math.abs(result.annualLoanRepayments - 52000) < 0.1, frequency + " (monthly cents rounding)");
+    assert.equal(result.annualDebtRepayments, 0, "Unconfirmed rental cashflow remains excluded");
+    assert.ok(result.rentalPropertyCashflow.warnings.length);
+    plan.liabilityItems[0].balance = 0;
+    assert.equal(CALC.calculatePlan(plan).annualLoanRepayments, 0);
+  }
+});
+test("Rental payment total counts each canonical loan once despite multiple income links", () => {
+  const plan = rentalPlan();
+  plan.incomeItems.push({ ...plan.incomeItems[0], id: "rent2" });
+  assert.equal(CALC.calculatePlan(plan).annualLoanRepayments, 36000);
+});
+
+test("Every non-property loan reduces net worth and contributes repayments once", () => {
+  for (const type of ["investmentLoan", "personalLoan", "vehicleLoan", "otherDebt", "shareInvestmentLoan", "managedFundLoan"]) {
+    const plan = CALC.emptyPlan();
+    plan.assets.cash = 100000;
+    plan.liabilityItems = [{ id: "loan", type, balance: 20000, repayment: 200, repaymentFrequency: "monthly", interestRatePct: 6, termYears: 10 }];
+    if (type === "otherDebt") plan.liabilities.otherDebts = 20000;
+    const result = CALC.calculatePlan(plan);
+    const debtFree = CALC.calculatePlan({ ...plan, liabilities: { ...plan.liabilities, otherDebts: 0 }, liabilityItems: [] });
+    assert.equal(result.currentNetWorth, 80000, type);
+    assert.equal(result.annualLoanRepayments, 2400, type);
+    assert.equal(result.annualDebtRepayments, 2400, type);
+    assert.equal(debtFree.cashSurplusBeforeInvesting - result.cashSurplusBeforeInvesting, 2400, type);
+    assert.equal(debtFree.netWorthProjection[0].closingBalance - result.netWorthProjection[0].closingBalance, 20000, type);
+    plan.liabilityItems[0].balance = 0;
+    const paidOff = CALC.calculatePlan(plan);
+    assert.equal(paidOff.currentNetWorth, 100000, type + " paid off overrides legacy");
+    assert.equal(paidOff.annualLoanRepayments, 0, type);
+  }
+});
+test("Non-property loan frequency and missing term use the existing capped debt schedule", () => {
